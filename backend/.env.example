APP_NAME="Bosta Analysis API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3001
FRONTEND_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3001,127.0.0.1:3001,localhost,127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bosta_analysis_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE=imports
DB_QUEUE_RETRY_AFTER=3900
# Optional absolute path outside the public web root for private workbook files.
# IMPORT_FILE_STORAGE_PATH=E:/data analysis/bosta-private/imports
IMPORT_BENCHMARK_ENABLED=false
IMPORT_BENCHMARK_DATABASE=bosta_analysis_benchmark
IMPORT_LOOKUP_BATCH_KEYS=400
IMPORT_SOURCE_CHUNK_ROWS=1000
IMPORT_DB_BATCH_ROWS=1000
IMPORT_DB_BATCH_BINDINGS=48000
IMPORT_DB_BATCH_BYTES=4194304
IMPORT_DB_PACKET_MARGIN_BYTES=65536
IMPORT_MAX_SOURCE_ROW_NUMBER=200000
IMPORT_XLS_READ_CHUNK_ROWS=400
IMPORT_WORKER_TIMEOUT=3600
IMPORT_WORKER_TRIES=3
# IMPORT_READER_TEMP_PATH=E:/data analysis/bosta-private/reader-temp

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
